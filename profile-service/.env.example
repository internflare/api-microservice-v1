# Service Environment
NODE_ENV=development
PORT=3004
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# MongoDB Atlas connection; optional database name overrides the URI database.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=internflare

# Authentication Service Integration
AUTH_SERVICE_URL=http://localhost:3001

# Microservice Shared Security
INTERNAL_SERVICE_SECRET=a-random-internal-service-secret-at-least-32-chars

# Cloudflare R2 file storage (CV and profile image uploads)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-bucket-name
# Public bucket URL (r2.dev subdomain or custom domain), no trailing slash
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
