{
  "name": "internflare-joblisting-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx src/db/run-migration.ts"
  },
  "dependencies": {
    "amqplib": "^2.2.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
