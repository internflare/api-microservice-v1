NODE_ENV=development
PORT=3005
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/internflare?retryWrites=true&w=majority
# Optional; set this to select a database when it is not included in MONGODB_URI.
# MONGODB_DB_NAME=internflare
RABBITMQ_URL=amqp://localhost:5672
AUTH_SERVICE_URL=http://localhost:3001
PROFILE_SERVICE_URL=http://localhost:3004
FRONTEND_URL=http://localhost:5173

# OpenAI generates new questions and grades open-ended answers (required).
OPENAI_API_KEY=sk-replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# Maximum assessments a user may start per rolling 24 hours.
MAX_ATTEMPTS_PER_DAY=5
